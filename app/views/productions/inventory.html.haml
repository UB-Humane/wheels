- content_for :title, "Inventory – #{@production.name}"

:javascript
  function addMany(item, inventoryId) {
    var input = window.prompt("How many to add?");
    if (input === null) return;
    var qty = parseInt(input, 10);
    if (!qty || qty <= 0) return;
    var form = document.createElement("form");
    form.method = "post";
    form.action = "/production_inventories/" + inventoryId;
    var fields = [
      ["_method", "patch"],
      ["item", item],
      ["action_type", "add"],
      ["quantity", qty],
      ["authenticity_token", document.querySelector('meta[name="csrf-token"]').content]
    ];
    fields.forEach(function(pair) {
      var inp = document.createElement("input");
      inp.type = "hidden";
      inp.name = pair[0];
      inp.value = pair[1];
      form.appendChild(inp);
    });
    document.body.appendChild(form);
    form.submit();
  }

.flex.flex-wrap.gap-6
  .border-2.border-gray-900.p-8.flex.flex-col.items-center.gap-6.flex-1.min-w-72
    %svg{viewBox: "0 0 120 90", width: "120", height: "120", fill: "none", xmlns: "http://www.w3.org/2000/svg", stroke: "currentColor", "stroke-width": "3", "stroke-linecap": "round", "stroke-linejoin": "round"}
      %path{d: "M18 68 Q18 18 60 18 Q102 18 102 68"}
      %line{x1: "8", y1: "68", x2: "112", y2: "68"}
      %line{x1: "18", y1: "68", x2: "14", y2: "82"}
      %line{x1: "102", y1: "68", x2: "106", y2: "82"}
      %rect{x: "44", y: "30", width: "7", height: "18", rx: "3.5", fill: "currentColor", stroke: "none"}
      %rect{x: "69", y: "30", width: "7", height: "18", rx: "3.5", fill: "currentColor", stroke: "none"}
    %p.text-2xl.font-bold.text-gray-900 Bike Helmets
    %p.text-6xl.font-bold.text-gray-900= @inventory.helmets
    .flex.flex-col.gap-3.w-full.mt-auto
      = button_to "Take 1", production_inventory_path(@inventory), method: :patch,
          params: { item: "helmets", action_type: "take" },
          class: "w-full px-6 py-4 text-xl font-bold text-white bg-gray-900 hover:bg-gray-700 cursor-pointer transition-colors border-0",
          disabled: @inventory.helmets == 0
      = button_to "Put Back 1", production_inventory_path(@inventory), method: :patch,
          params: { item: "helmets", action_type: "add", quantity: 1 },
          class: "w-full px-4 py-2 text-xl font-medium text-gray-900 underline bg-transparent border-0 cursor-pointer"
      %button.w-full.px-6.py-4.text-xl.font-bold.text-gray-900.border-2.border-gray-900.cursor-pointer.bg-white{type: "button", onclick: "addMany('helmets', #{@inventory.id})"} Add Many

