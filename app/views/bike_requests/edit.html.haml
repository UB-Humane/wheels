- content_for :title, "Edit Bike Request"
.max-w-4xl
  %h1.text-3xl.font-bold.text-gray-900.mb-8 Edit Bike Request

  = form_with model: @bike_request, class: "space-y-8" do |f|
    - if @bike_request.errors.any?
      .mb-4.space-y-1
        - @bike_request.errors.full_messages.each do |msg|
          %p.text-lg.text-red-700= msg
    .space-y-2
      = f.label :due_date, "Due date", class: "block text-xl font-medium text-gray-900"
      = f.date_field :due_date, class: "w-full px-4 py-3 text-xl border-2 border-gray-400 focus:border-gray-900 focus:outline-none"
      - @bike_request.errors[:due_date].each do |msg|
        %p.text-lg.text-red-700= msg

    %div{data: { controller: "bike-form",
                 "bike-form-max-bikes-value": BikeRequest::MAX_BIKES,
                 "bike-form-row-index-value": @bike_request.bikes.size }}
      .space-y-2.mb-4
        %label.block.text-xl.font-medium.text-gray-900
          How many bikes?
          %span.text-red-600 *
        %input.w-32.px-4.py-3.text-xl.border-2.border-gray-400.focus:border-gray-900.focus:outline-none{
          type: "number", value: [@bike_request.bikes.size, 1].max, required: true,
          data: { "bike-form-target": "countInput", action: "focus->bike-form#selectAll input->bike-form#setCount blur->bike-form#normalizeCount" }
        }
      %p.text-xl.font-semibold.text-gray-900.mb-3 Bikes
      .overflow-x-auto
        %table.w-full.border-collapse
          %thead
            %tr.border-b-2.border-gray-900
              %th.text-left.px-3.py-2.text-lg.font-semibold.text-gray-900 Name
              %th.text-left.px-3.py-2.text-lg.font-semibold.text-gray-900 Type
              %th.text-left.px-3.py-2.text-lg.font-semibold.text-gray-900 Age
              %th.text-left.px-3.py-2.text-lg.font-semibold.text-gray-900 Height
              %th.text-left.px-3.py-2.text-lg.font-semibold.text-gray-900 Notes
              %th
          %tbody{data: { "bike-form-target": "tbody" }}
            = f.fields_for :bikes do |bf|
              %tr.bike-row
                %td.px-3.py-2
                  = bf.text_field :name, placeholder: "optional",
                      class: "w-full px-2 py-1 text-lg border-2 border-gray-400 focus:border-gray-900 focus:outline-none"
                %td.px-3.py-2
                  = bf.select :bike_type, [["Any", "any"], ["Male", "male"], ["Female", "female"], ["Kid", "kid"]],
                      {}, class: "px-2 py-1 text-lg border-2 border-gray-400 bg-white"
                %td.px-3.py-2
                  = bf.number_field :age, min: 1, max: 120,
                      class: "w-20 px-2 py-1 text-lg border-2 border-gray-400 focus:border-gray-900 focus:outline-none"
                %td.px-3.py-2
                  = bf.text_field :height, placeholder: "5'4\"",
                      class: "w-28 px-2 py-1 text-lg border-2 border-gray-400 focus:border-gray-900 focus:outline-none"
                %td.px-3.py-2
                  = bf.text_field :notes,
                      class: "w-full px-2 py-1 text-lg border-2 border-gray-400 focus:border-gray-900 focus:outline-none"
                %td.px-3.py-2
                  = bf.hidden_field :_destroy, value: false, class: "destroy-field"
                  %button.px-3.py-1.text-lg.font-medium.text-gray-500.underline.bg-transparent.border-0.cursor-pointer{type: "button", data: { action: "click->bike-form#removeBike" }} Remove

    .flex.gap-4
      = f.submit "Resubmit for Approval", class: "px-6 py-3 text-lg font-bold text-white bg-gray-900 hover:bg-gray-700 cursor-pointer transition-colors"
      = link_to "Cancel", tickets_distribution_path(@bike_request.distribution), class: "px-6 py-3 text-lg font-medium text-gray-900 underline"

%template#bike-row-template
  %td.px-3.py-2
    %input.w-full.px-2.py-1.text-lg.border-2.border-gray-400.focus:border-gray-900.focus:outline-none{type: "text", name: "bike_request[bikes_attributes][NEW_INDEX][name]", placeholder: "optional"}
  %td.px-3.py-2
    %select.px-2.py-1.text-lg.border-2.border-gray-400.bg-white{name: "bike_request[bikes_attributes][NEW_INDEX][bike_type]"}
      %option{value: "any"} Any
      %option{value: "male"} Male
      %option{value: "female"} Female
      %option{value: "kid"} Kid
  %td.px-3.py-2
    %input.w-20.px-2.py-1.text-lg.border-2.border-gray-400.focus:border-gray-900.focus:outline-none{type: "number", name: "bike_request[bikes_attributes][NEW_INDEX][age]", min: "1", max: "120"}
  %td.px-3.py-2
    %input.w-28.px-2.py-1.text-lg.border-2.border-gray-400.focus:border-gray-900.focus:outline-none{type: "text", name: "bike_request[bikes_attributes][NEW_INDEX][height]", placeholder: "5'4\""}
  %td.px-3.py-2
    %input.w-full.px-2.py-1.text-lg.border-2.border-gray-400.focus:border-gray-900.focus:outline-none{type: "text", name: "bike_request[bikes_attributes][NEW_INDEX][notes]"}
  %td.px-3.py-2
    %button.px-3.py-1.text-lg.font-medium.text-gray-500.underline.bg-transparent.border-0.cursor-pointer{type: "button", data: { action: "click->bike-form#removeBike" }} Remove
