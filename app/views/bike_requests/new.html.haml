- content_for :title, "Request Bikes"
.max-w-4xl
  %h1.text-3xl.font-bold.text-gray-900.mb-8 Request Bikes

  - owner_search_data = @production_requester ? { controller: "owner-search distribution-search", action: "click@window->owner-search#closeDropdown click@window->distribution-search#closeDropdown", "owner-search-production-id-value" => @production_requester.id, "distribution-search-production-id-value" => @production_requester.id } : {}
  - show_distribution_search = @production_requester && (production_admin?(@production_requester) || production_master_mechanic?(@production_requester))
  = form_with model: (@distribution ? [@distribution, @bike_request] : [@production_requester, @bike_request]), class: "space-y-8", data: owner_search_data do |f|
    - if @bike_request.errors.any?
      .mb-4.space-y-1
        - @bike_request.errors.full_messages.each do |msg|
          %p.text-lg.text-red-700= msg
    .space-y-2
      = f.label :due_date, class: "block text-xl font-medium text-gray-900" do
        Due date
        %span.text-red-600 *
      = f.date_field :due_date, class: "w-full px-4 py-3 text-xl border-2 border-gray-400 focus:border-gray-900 focus:outline-none"
      - @bike_request.errors[:due_date].each do |msg|
        %p.text-lg.text-red-700= msg

    - if show_distribution_search
      .space-y-2
        %label.block.text-xl.font-medium.text-gray-900 Request on behalf of a distribution (optional)
        .relative
          %input.w-full.px-4.py-3.text-xl.border-2.border-gray-400.focus:border-gray-900.focus:outline-none{
            type: "text", autocomplete: "off", placeholder: "Search distributions...",
            data: { "distribution-search-target": "input", action: "input->distribution-search#search" }
          }
          %ul.absolute.z-10.bg-white.border-2.border-gray-900.w-full.p-0.m-0{
            hidden: true, style: "max-height:200px;overflow-y:auto",
            data: { "distribution-search-target": "dropdown" }
          }
        %input{type: "hidden", name: "bike_request[distribution_id]", data: { "distribution-search-target": "hidden" }}

    - if @production_requester
      .space-y-2
        %label.block.text-xl.font-medium.text-gray-900
          Owner
          %span.text-red-600 *
        .relative
          %input.w-full.px-4.py-3.text-xl.border-2.border-gray-400.focus:border-gray-900.focus:outline-none{
            type: "text", autocomplete: "off", placeholder: "Search by name or email...",
            data: { "owner-search-target": "input", action: "input->owner-search#search" }
          }
          %ul.absolute.z-10.bg-white.border-2.border-gray-900.w-full.p-0.m-0{
            hidden: true, style: "max-height:200px;overflow-y:auto",
            data: { "owner-search-target": "dropdown" }
          }
        %input{type: "hidden", name: "bike_request[owner_id]", data: { "owner-search-target": "hidden" }}

    %div{data: { controller: "bike-form",
                 "bike-form-max-bikes-value": BikeRequest::MAX_BIKES,
                 "bike-form-row-index-value": 1 }}
      .space-y-2.mb-4
        %label.block.text-xl.font-medium.text-gray-900
          How many bikes?
          %span.text-red-600 *
        %input.w-32.px-4.py-3.text-xl.border-2.border-gray-400.focus:border-gray-900.focus:outline-none{
          type: "number", value: 1, required: true,
          data: { "bike-form-target": "countInput", action: "focus->bike-form#selectAll input->bike-form#setCount blur->bike-form#normalizeCount" }
        }
      %p.text-xl.font-semibold.text-gray-900.mb-3 Bikes
      .overflow-x-auto
        %table.w-full.border-collapse
          %thead
            %tr.border-b-2.border-gray-900
              %th.text-left.px-3.py-2.text-lg.font-semibold.text-gray-900 Name
              %th.text-left.px-3.py-2.text-lg.font-semibold.text-gray-900 Type
              %th.text-left.px-3.py-2.text-lg.font-semibold.text-gray-900 Age
              %th.text-left.px-3.py-2.text-lg.font-semibold.text-gray-900 Height
              %th.text-left.px-3.py-2.text-lg.font-semibold.text-gray-900 Notes
              %th
          %tbody{data: { "bike-form-target": "tbody" }}
            = f.fields_for :bikes do |bf|
              = render "bike_form_row", bf: bf

    .flex.gap-4
      - if @production_requester
        = f.submit "Submit Request", disabled: true,
            class: "px-6 py-3 text-lg font-bold text-white bg-gray-900 hover:bg-gray-700 transition-colors opacity-50 cursor-not-allowed",
            data: { "owner-search-target": "button" }
      - else
        = f.submit "Submit Request", class: "px-6 py-3 text-lg font-bold text-white bg-gray-900 hover:bg-gray-700 cursor-pointer transition-colors"
      = link_to "Cancel", (@distribution ? tickets_distribution_path(@distribution) : tickets_production_path(@production_requester)), class: "px-6 py-3 text-lg font-medium text-gray-900 underline"

%template#bike-row-template
  %td.px-3.py-2
    %input.w-full.px-2.py-1.text-lg.border-2.border-gray-400.focus:border-gray-900.focus:outline-none{type: "text", name: "bike_request[bikes_attributes][NEW_INDEX][name]", placeholder: "optional"}
  %td.px-3.py-2
    %select.px-2.py-1.text-lg.border-2.border-gray-400.bg-white{name: "bike_request[bikes_attributes][NEW_INDEX][bike_type]"}
      %option{value: "male"} Male
      %option{value: "female"} Female
      %option{value: "kid"} Kid
  %td.px-3.py-2
    %input.w-20.px-2.py-1.text-lg.border-2.border-gray-400.focus:border-gray-900.focus:outline-none{type: "number", name: "bike_request[bikes_attributes][NEW_INDEX][age]"}
  %td.px-3.py-2
    %input.w-28.px-2.py-1.text-lg.border-2.border-gray-400.focus:border-gray-900.focus:outline-none{type: "text", name: "bike_request[bikes_attributes][NEW_INDEX][height]", placeholder: "5'4\""}
  %td.px-3.py-2
    %input.w-full.px-2.py-1.text-lg.border-2.border-gray-400.focus:border-gray-900.focus:outline-none{type: "text", name: "bike_request[bikes_attributes][NEW_INDEX][notes]"}
  %td.px-3.py-2
    %button.px-3.py-1.text-lg.font-medium.text-gray-500.underline.bg-transparent.border-0.cursor-pointer{type: "button", data: { action: "click->bike-form#removeBike" }} Remove
