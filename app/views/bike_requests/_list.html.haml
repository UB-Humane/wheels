:javascript
  function printAllBikeLabels(bikes, requestor, phone, due) {
    var pages = [];
    bikes.forEach(function(b) {
      var name = b[0], type = b[1], age = b[2], height = b[3], notes = b[4];
      var lines = [];
      if (name) lines.push('<p style="font-size:18pt;font-weight:bold;margin:0">' + name + '</p>');
      var detail = type;
      if (age) detail += ' &middot; Age ' + age;
      if (height) detail += ' &middot; ' + height;
      lines.push('<p style="font-size:14pt;margin:4px 0">' + detail + '</p>');
      if (notes) lines.push('<p style="font-size:12pt;margin:4px 0">' + notes + '</p>');
      lines.push('<p style="font-size:11pt;color:#555;margin:8px 0 0">' + requestor + ' &middot; ' + phone + '</p>');
      lines.push('<p style="font-size:11pt;color:#555;margin:2px 0">Due ' + due + '</p>');
      pages.push('<div style="' + (pages.length > 0 ? 'page-break-before:always;' : '') + 'padding:12px">' + lines.join('') + '</div>');
    });
    var win = window.open('', '_blank', 'width=400,height=600');
    win.document.write('<html><body style="font-family:sans-serif;margin:0">' + pages.join('') + '<script>window.onload=function(){window.print();window.close();}<\/script></body></html>');
    win.document.close();
  }
  function printCard(bikes, requestor, phone, due) {
    var rows = '';
    bikes.forEach(function(b, i) {
      var name = b[0], type = b[1], age = b[2], height = b[3], notes = b[4];
      var specs = [type, age ? 'Age ' + age : '', height].filter(Boolean).join(' · ');
      rows += '<tr style="border-bottom:1px solid #ddd">';
      rows += '<td style="padding:8px 10px;font-size:13pt;color:#888;vertical-align:top">' + (i + 1) + '</td>';
      rows += '<td style="padding:8px 10px;vertical-align:top">';
      if (name) rows += '<div style="font-size:15pt;font-weight:bold;margin-bottom:2px">' + name + '</div>';
      rows += '<div style="font-size:13pt;color:#333">' + specs + '</div>';
      if (notes) rows += '<div style="font-size:12pt;color:#666;margin-top:3px">' + notes + '</div>';
      rows += '</td></tr>';
    });
    var html =
      '<div style="border-bottom:2px solid #000;padding-bottom:10px;margin-bottom:14px">' +
        '<div style="font-size:18pt;font-weight:bold">' + requestor + '</div>' +
        '<div style="font-size:13pt;color:#555;margin-top:3px">' + phone + ' &nbsp;&middot;&nbsp; Due ' + due + '</div>' +
      '</div>' +
      '<table style="width:100%;border-collapse:collapse">' + rows + '</table>';
    var win = window.open('', '_blank', 'width=700,height=1000');
    win.document.write('<html><body style="font-family:sans-serif;padding:20px;max-width:660px">' + html + '<script>window.onload=function(){window.print();window.close();}<\/script></body></html>');
    win.document.close();
  }
- tabs = %w[requested pending ready_for_delivery delivered distributed archived]
.flex.border-b-2.border-gray-900.mb-8
  - tabs.each do |tab|
    = link_to url_for(tab: tab), class: "px-6 py-3 text-lg font-medium #{active_tab == tab ? 'font-bold border-b-4 border-gray-900 -mb-0.5' : 'text-gray-500'}" do
      = tab.titleize
      %span.ml-1= "(#{tab_counts[tab] || 0})"

- if bike_requests.any?
  .space-y-4
    - bike_requests.each do |req|
      - card_border = req.denied? ? "border-2 border-red-600" : "border-2 border-gray-900"
      .px-6.py-5.space-y-4{class: card_border}
        .flex.items-start.justify-between.gap-4
          .space-y-1
            %p.text-2xl.font-bold.text-gray-900= req.distribution&.name || "Production Request"
            - if req.owner.present?
              %p.text-lg.text-gray-500
                Owned by
                = req.owner.name
            %p.text-lg.text-gray-500= req.requestor_name
            %p.text-lg.text-gray-600= req.phone
          .flex.flex-col.items-end.gap-1
            - if req.denied?
              %p.text-2xl.font-bold.text-red-600 DENIED
              - if req.denial_reason.present?
                %p.text-lg.text-red-600= req.denial_reason
            .flex.items-center.gap-4
              %p.text-lg.font-medium.text-gray-900 Due #{req.due_date.strftime("%-m/%-d/%Y")}
              - if production_view && !req.archived?
                = button_to bike_request_path(req), method: :patch, params: { status: "archive" }, class: "p-1 text-gray-400 hover:text-gray-700 bg-transparent border-0 cursor-pointer", title: "Archive", form: { style: "display:inline" } do
                  %svg{xmlns: "http://www.w3.org/2000/svg", width: "24", height: "24", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round", "stroke-linejoin": "round"}
                    %rect{x: "1", y: "3", width: "22", height: "5"}
                    %polyline{points: "21 8 21 21 3 21 3 8"}
                    %line{x1: "10", y1: "13", x2: "14", y2: "13"}

        %details.bg-gray-50.border.border-gray-200
          %summary.flex.items-center.justify-between.px-3.py-2.text-lg.font-medium.text-gray-700.cursor-pointer.select-none.list-none
            = pluralize(req.bikes.size, "bike")
            %span.text-gray-400 ▾
          .overflow-x-auto.mt-3
            %table.w-full.border-collapse
              %thead
                %tr.border-b-2.border-gray-200
                  %th.text-left.px-3.py-2.text-lg.font-semibold.text-gray-700 Name
                  %th.text-left.px-3.py-2.text-lg.font-semibold.text-gray-700 Type
                  %th.text-left.px-3.py-2.text-lg.font-semibold.text-gray-700 Age
                  %th.text-left.px-3.py-2.text-lg.font-semibold.text-gray-700 Height
                  %th.text-left.px-3.py-2.text-lg.font-semibold.text-gray-700 Notes
              %tbody
                - req.bikes.each do |bike|
                  %tr.border-b.border-gray-200
                    %td.px-3.py-2.text-lg.text-gray-900= bike.name.presence || "—"
                    %td.px-3.py-2.text-lg.text-gray-900= bike.bike_type.capitalize
                    %td.px-3.py-2.text-lg.text-gray-900= bike.age || "—"
                    %td.px-3.py-2.text-lg.text-gray-900= bike.height.presence || "—"
                    %td.px-3.py-2.text-lg.text-gray-900= bike.notes.presence || "—"


        .flex.gap-4.mt-2
          - if production_view
            - if req.requested?
              = form_with url: bike_request_path(req), method: :patch, class: "flex items-center gap-3" do |f|
                = hidden_field_tag :status, "approve"
                = hidden_field_tag :owner_id, "", id: "owner-id-#{req.id}"
                .relative
                  %input.px-3.py-2.text-lg.border-2.border-gray-400.focus:border-gray-900.focus:outline-none{
                    type: "text", autocomplete: "off",
                    id: "owner-search-#{req.id}",
                    placeholder: "Assign to..."
                  }
                  %ul.absolute.z-10.bg-white.border-2.border-gray-900.w-full.p-0.m-0{
                    id: "owner-drop-#{req.id}", hidden: true, style: "max-height:200px;overflow-y:auto"
                  }
                = submit_tag "Approve", disabled: true,
                    id: "approve-btn-#{req.id}",
                    class: "px-6 py-3 text-lg font-bold text-white bg-gray-900 hover:bg-gray-700 transition-colors border-0 opacity-50 cursor-not-allowed"
              :javascript
                document.addEventListener('DOMContentLoaded', function() {
                  window.setupOwnerSearch('owner-search-#{req.id}', 'owner-id-#{req.id}', 'owner-drop-#{req.id}', 'approve-btn-#{req.id}', #{req.production.id});
                });
              = form_with url: bike_request_path(req), method: :patch, class: "flex gap-2 items-center" do |f|
                = hidden_field_tag :status, "deny"
                = text_field_tag :denial_reason, nil, placeholder: "Reason (optional)", class: "px-3 py-2 text-lg border-2 border-gray-400 focus:border-gray-900 focus:outline-none"
                = submit_tag "Deny", class: "px-6 py-3 text-lg font-bold text-white bg-red-700 hover:bg-red-600 cursor-pointer transition-colors border-0"
            - elsif req.pending? && production_master_mechanic?(req.production)
              = button_to "Ready for Delivery", complete_all_bike_request_path(req), method: :patch,
                  class: "px-6 py-3 text-lg font-bold text-white bg-gray-900 hover:bg-gray-700 cursor-pointer transition-colors border-0"
            - elsif req.ready_for_delivery?
              = button_to "Mark Delivered", bike_request_path(req), method: :patch, params: { status: "delivered" },
                  class: "px-6 py-3 text-lg font-bold text-white bg-gray-900 hover:bg-gray-700 cursor-pointer transition-colors border-0"
            - elsif req.delivered?
              = button_to "Back to Ready for Delivery", bike_request_path(req), method: :patch, params: { status: "ready_for_delivery" },
                  class: "px-4 py-2 text-lg font-medium text-gray-900 underline bg-transparent border-0 cursor-pointer"
            - elsif req.distributed?
              = button_to "Back to Delivered", bike_request_path(req), method: :patch, params: { status: "delivered" },
                  class: "px-4 py-2 text-lg font-medium text-gray-900 underline bg-transparent border-0 cursor-pointer"
            - elsif req.archived?
              = button_to "Unarchive", bike_request_path(req), method: :patch, params: { status: "unarchive" },
                  class: "px-4 py-2 text-lg font-medium text-gray-900 underline bg-transparent border-0 cursor-pointer"
          - else
            - if req.requested? || req.denied?
              = link_to "Edit", edit_bike_request_path(req), class: "px-4 py-2 text-lg font-medium text-gray-900 underline"
          - if req.delivered? && requestor_for?(req)
            = button_to "Mark Distributed", bike_request_path(req), method: :patch, params: { status: "distributed" },
                class: "px-6 py-3 text-lg font-bold text-white bg-gray-900 hover:bg-gray-700 cursor-pointer transition-colors border-0"
          - if production_view && !req.requested? && !req.archived?
            %button.text-lg.font-medium.text-gray-900.underline.bg-transparent.border-0.cursor-pointer.self-center{type: "button", onclick: "printAllBikeLabels(#{req.bikes_label_data.to_json}, #{req.requestor_name.to_json}, #{req.phone.to_json}, #{req.due_date.strftime('%-m/%-d/%Y').to_json})"} Print All
            %button.text-lg.font-medium.text-gray-900.underline.bg-transparent.border-0.cursor-pointer.self-center{type: "button", onclick: "printCard(#{req.bikes_label_data.to_json}, #{req.requestor_name.to_json}, #{req.phone.to_json}, #{req.due_date.strftime('%-m/%-d/%Y').to_json})"} Print Overview

  - if pagy.pages > 1
    .flex.items-center.gap-6.mt-8.text-lg
      - if pagy.prev
        = link_to "← Previous", url_for(tab: active_tab, page: pagy.prev), class: "text-gray-900 underline"
      %span.text-gray-500 Page #{pagy.page} of #{pagy.pages}
      - if pagy.next
        = link_to "Next →", url_for(tab: active_tab, page: pagy.next), class: "text-gray-900 underline"
- else
  %p.text-xl.text-gray-500= "No requests #{active_tab.gsub("_", " ")}."
