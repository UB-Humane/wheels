.flex.border-b-2.border-gray-900.mb-8
  - tabs.each do |tab|
    = link_to url_for(tab: tab), class: "px-6 py-3 text-lg font-medium #{active_tab == tab ? 'font-bold border-b-4 border-gray-900 -mb-0.5' : 'text-gray-500'}" do
      = tab.titleize
      %span.ml-1= "(#{tab_counts[tab] || 0})"

- if bike_requests.any?
  .space-y-4
    - bike_requests.each do |req|
      - card_border = (req.denied? || req.overdue?) ? "border-2 border-red-600" : "border-2 border-gray-900"
      - can_correct_status = production_view && (production_admin?(req.production) || production_master_mechanic?(req.production))
      - can_complete_delivery = production_view && (can_correct_status || current_user == req.owner || current_user == req.taker)
      .px-6.py-5.space-y-4{class: card_border,
        data: { controller: "print",
                "print-bikes-value":     req.bikes_label_data.to_json,
                "print-requestor-value": req.user.name,
                "print-source-value":    req.distribution&.name || "Production Request",
                "print-codename-value":  req.codename,
                "print-phone-value":     req.user.mobile_number,
                "print-owner-value":     req.owner.present? ? "#{req.owner.name} (#{req.owner.mobile_number})" : "",
                "print-due-value":       req.due_date.strftime("%-m/%-d/%Y") }}
        .flex.items-start.justify-between.gap-4
          .space-y-1
            .flex.items-baseline.gap-2
              %p.text-2xl.font-bold.text-gray-900= req.distribution&.name || "Production Request"
              %p.text-lg.text-gray-500= req.codename
            - if req.owner.present?
              %p.text-lg.text-gray-500
                Owned by
                = req.owner.name
                = "(#{req.owner.mobile_number})"
            - if req.taker.present?
              %p.text-lg.text-gray-500
                Picked up by
                = req.taker.name
            %p.text-lg.text-gray-500
              Requested by
              = req.user.name
              = "(#{req.user.mobile_number})"
          .flex.flex-col.items-end.gap-1
            - if req.denied?
              %p.text-2xl.font-bold.text-red-600 DENIED
              - if req.denial_reason.present?
                %p.text-lg.text-red-600= req.denial_reason
            .flex.items-center.gap-4
              - if req.overdue?
                %p.text-lg.font-bold.text-red-600 OVERDUE
              %p.text-lg.font-medium.text-gray-900 Due #{req.due_date.strftime("%-m/%-d/%Y")}
              - if production_view && !req.archived?
                = button_to bike_request_path(req), method: :patch, params: { status: "archive" }, class: "p-1 text-gray-400 hover:text-gray-700 bg-transparent border-0 cursor-pointer", title: "Archive", form: { style: "display:inline" } do
                  %svg{xmlns: "http://www.w3.org/2000/svg", width: "24", height: "24", viewBox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round", "stroke-linejoin": "round"}
                    %rect{x: "1", y: "3", width: "22", height: "5"}
                    %polyline{points: "21 8 21 21 3 21 3 8"}
                    %line{x1: "10", y1: "13", x2: "14", y2: "13"}

        %details.bg-gray-50.border.border-gray-200
          %summary.flex.items-center.justify-between.px-3.py-2.text-lg.font-medium.text-gray-700.cursor-pointer.select-none.list-none
            = pluralize(req.bikes.size, "bike")
            %span.text-gray-400 ▾
          .overflow-x-auto.mt-3
            %table.w-full.border-collapse
              %thead
                %tr.border-b-2.border-gray-200
                  %th.text-left.px-3.py-2.text-lg.font-semibold.text-gray-700 Name
                  %th.text-left.px-3.py-2.text-lg.font-semibold.text-gray-700 Type
                  %th.text-left.px-3.py-2.text-lg.font-semibold.text-gray-700 Age
                  %th.text-left.px-3.py-2.text-lg.font-semibold.text-gray-700 Height
                  %th.text-left.px-3.py-2.text-lg.font-semibold.text-gray-700 Notes
              %tbody
                - req.bikes.each do |bike|
                  %tr.border-b.border-gray-200
                    %td.px-3.py-2.text-lg.text-gray-900= bike.name.presence || "—"
                    %td.px-3.py-2.text-lg.text-gray-900= bike.bike_type.capitalize
                    %td.px-3.py-2.text-lg.text-gray-900= bike.age || "—"
                    %td.px-3.py-2.text-lg.text-gray-900= bike.height.presence || "—"
                    %td.px-3.py-2.text-lg.text-gray-900= bike.notes.presence || "—"


        .flex.gap-4.mt-2
          - if production_view
            - if req.requested?
              - owner_search_data = { controller: "owner-search", action: "click@window->owner-search#closeDropdown", "owner-search-production-id-value" => req.production.id }
              = form_with url: bike_request_path(req), method: :patch, class: "flex items-center gap-3", data: owner_search_data do |f|
                = hidden_field_tag :status, "approve"
                = hidden_field_tag :owner_id, "", data: { "owner-search-target": "hidden" }
                .relative
                  %input.px-3.py-2.text-lg.border-2.border-gray-400.focus:border-gray-900.focus:outline-none{
                    type: "text", autocomplete: "off",
                    placeholder: "Assign to...",
                    data: { "owner-search-target": "input", action: "input->owner-search#search" }
                  }
                  %ul.absolute.z-10.bg-white.border-2.border-gray-900.w-full.p-0.m-0{
                    hidden: true, style: "max-height:200px;overflow-y:auto",
                    data: { "owner-search-target": "dropdown" }
                  }
                = submit_tag "Approve", disabled: true,
                    class: "px-6 py-3 text-lg font-bold text-white bg-gray-900 hover:bg-gray-700 transition-colors border-0 opacity-50 cursor-not-allowed",
                    data: { "owner-search-target": "button" }
              = form_with url: bike_request_path(req), method: :patch, class: "flex gap-2 items-center" do |f|
                = hidden_field_tag :status, "deny"
                = text_field_tag :denial_reason, nil, placeholder: "Reason (optional)", class: "px-3 py-2 text-lg border-2 border-gray-400 focus:border-gray-900 focus:outline-none"
                = submit_tag "Deny", class: "px-6 py-3 text-lg font-bold text-white bg-red-700 hover:bg-red-600 cursor-pointer transition-colors border-0"
            - elsif req.pending?
              - if can_correct_status
                = button_to "Ready for Delivery", complete_all_bike_request_path(req), method: :patch,
                    class: "px-6 py-3 text-lg font-bold text-white bg-gray-900 hover:bg-gray-700 cursor-pointer transition-colors border-0"
              - if can_correct_status
                = button_to "Back to Requested", bike_request_path(req), method: :patch, params: { status: "back_to_requested" },
                    class: "px-4 py-2 text-lg font-medium text-gray-900 underline bg-transparent border-0 cursor-pointer"
            - elsif req.ready_for_delivery?
              = button_to "I've got this", bike_request_path(req), method: :patch, params: { status: "taken_up" },
                  class: "px-6 py-3 text-lg font-bold text-white bg-gray-900 hover:bg-gray-700 cursor-pointer transition-colors border-0"
              - if can_correct_status
                = button_to "Back to Pending", bike_request_path(req), method: :patch, params: { status: "back_to_pending" },
                    class: "px-4 py-2 text-lg font-medium text-gray-900 underline bg-transparent border-0 cursor-pointer"
            - elsif req.taken_up?
              - if can_complete_delivery
                = button_to "I'm done!", bike_request_path(req), method: :patch, params: { status: "delivered" },
                    class: "px-6 py-3 text-lg font-bold text-white bg-gray-900 hover:bg-gray-700 cursor-pointer transition-colors border-0"
              - if can_correct_status
                = button_to "Back to Ready for Delivery", bike_request_path(req), method: :patch, params: { status: "back_to_ready_for_delivery" },
                    class: "px-4 py-2 text-lg font-medium text-gray-900 underline bg-transparent border-0 cursor-pointer"
            - elsif req.delivered?
              - if (req.distribution.nil? && requestor_for?(req)) || can_correct_status
                = button_to "Mark Distributed", bike_request_path(req), method: :patch, params: { status: "distributed" },
                    class: "px-6 py-3 text-lg font-bold text-white bg-gray-900 hover:bg-gray-700 cursor-pointer transition-colors border-0"
              - if can_correct_status
                = button_to "Back to Taken Up", bike_request_path(req), method: :patch, params: { status: "back_to_taken_up" },
                    class: "px-4 py-2 text-lg font-medium text-gray-900 underline bg-transparent border-0 cursor-pointer"
            - elsif req.archived?
              = button_to "Unarchive", bike_request_path(req), method: :patch, params: { status: "unarchive" },
                  class: "px-4 py-2 text-lg font-medium text-gray-900 underline bg-transparent border-0 cursor-pointer"
          - else
            - if req.requested? || req.denied?
              = link_to "Edit", edit_bike_request_path(req), class: "px-4 py-2 text-lg font-medium text-gray-900 underline"
          - if !production_view && req.delivered? && requestor_for?(req)
            = button_to "Mark Distributed", bike_request_path(req), method: :patch, params: { status: "distributed" },
                class: "px-6 py-3 text-lg font-bold text-white bg-gray-900 hover:bg-gray-700 cursor-pointer transition-colors border-0"
          - if production_view && !req.requested? && !req.archived?
            %button.text-lg.font-medium.text-gray-900.underline.bg-transparent.border-0.cursor-pointer.self-center{type: "button", data: { action: "click->print#printLabels" }} Print All
            %button.text-lg.font-medium.text-gray-900.underline.bg-transparent.border-0.cursor-pointer.self-center{type: "button", data: { action: "click->print#printCard" }} Print Overview

  - if pagy.pages > 1
    .flex.items-center.gap-6.mt-8.text-lg
      - if pagy.prev
        = link_to "← Previous", url_for(tab: active_tab, page: pagy.prev), class: "text-gray-900 underline"
      %span.text-gray-500 Page #{pagy.page} of #{pagy.pages}
      - if pagy.next
        = link_to "Next →", url_for(tab: active_tab, page: pagy.next), class: "text-gray-900 underline"
- else
  %p.text-xl.text-gray-500= "No requests #{active_tab.gsub("_", " ")}."
