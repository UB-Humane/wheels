!!!
%html
  %head
    %meta{:content => "text/html; charset=UTF-8", "http-equiv" => "Content-Type"}/
    %title= content_for(:title) || "Wheels"
    %meta{:content => "width=device-width,initial-scale=1", :name => "viewport"}/
    %meta{:content => "yes", :name => "apple-mobile-web-app-capable"}/
    %meta{:content => "Wheels", :name => "application-name"}/
    %meta{:content => "yes", :name => "mobile-web-app-capable"}/
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    %link{:href => "/icon.png", :rel => "icon", :type => "image/png"}/
    %link{:href => "/icon.svg", :rel => "icon", :type => "image/svg+xml"}/
    %link{:href => "/icon.png", :rel => "apple-touch-icon"}/
    = stylesheet_link_tag "tailwind", "data-turbo-track": "reload"
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    = javascript_importmap_tags
  %body.bg-white.min-h-screen
    - if current_user
      %nav.border-b-2.border-gray-900.px-6.py-4.flex.items-center.justify-between
        .flex.items-center
          = link_to root_path, class: "px-3 text-gray-900 hover:text-gray-600 transition-colors", aria: { label: "Home" } do
            %svg{xmlns: "http://www.w3.org/2000/svg", viewBox: "0 0 24 24", fill: "currentColor", width: "22", height: "22"}
              %path{d: "M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"}
          - if @location_name
            .w-px.h-6.bg-gray-400.mx-1
            %span.px-3.text-lg.font-semibold.text-gray-900= @location_name
            - if @location_show_your_tickets && !delivery_only_host?
              = link_to "Your Tickets", @location_your_tickets_path,
                  class: "ml-2 px-4 py-2 text-lg font-medium #{@location_active == :your_tickets ? 'bg-gray-900 text-white' : 'text-gray-900'}"
            - if @location_show_tickets && !delivery_only_host?
              = link_to "Bike Tickets", @location_path,
                  class: "#{'ml-2' unless @location_show_your_tickets} px-4 py-2 text-lg font-medium #{@location_active == :tickets ? 'bg-gray-900 text-white' : 'text-gray-900'}"
            - if @location_show_delivery
              = link_to "Delivery", @location_delivery_path,
                  class: "#{'ml-2' if delivery_only_host?} px-4 py-2 text-lg font-medium #{@location_active == :delivery ? 'bg-gray-900 text-white' : 'text-gray-900'}"
            - if @location_inventory_path && !delivery_only_host?
              = link_to "Inventory", @location_inventory_path,
                  class: "px-4 py-2 text-lg font-medium #{@location_active == :inventory ? 'bg-gray-900 text-white' : 'text-gray-900'}"
            - if @location_donors_path && !delivery_only_host?
              = link_to "Donors", @location_donors_path,
                  class: "px-4 py-2 text-lg font-medium #{@location_active == :donors ? 'bg-gray-900 text-white' : 'text-gray-900'}"
            - if @location_admin && !delivery_only_host?
              = link_to "Manage Users", @location_users_path,
                  class: "px-4 py-2 text-lg font-medium #{@location_active == :users ? 'bg-gray-900 text-white' : 'text-gray-900'}"
        .flex.items-center.gap-8
          = link_to edit_profile_path, class: "flex items-center gap-2 text-lg text-gray-700 hover:text-gray-900 transition-colors" do
            %span= current_user.name
            %svg{xmlns: "http://www.w3.org/2000/svg", viewBox: "0 0 24 24", fill: "currentColor", width: "16", height: "16", aria: { hidden: "true" }}
              %path{d: "M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"}
          = button_to "Log out", logout_path, method: :delete, class: "text-lg font-medium text-gray-900 underline bg-transparent border-0 cursor-pointer"
    - if flash[:notice]
      .px-6.py-3.bg-green-100.border-b.border-green-300.text-green-900.text-lg= flash[:notice]
    - if flash[:alert]
      .px-6.py-3.bg-red-100.border-b.border-red-300.text-red-900.text-lg= flash[:alert]
    .px-6.py-8
      = yield
